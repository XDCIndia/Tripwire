# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Not a secret: it only names the local Vite port, and every developer needs
# the same value for `/app` to work in `next dev`.
!.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# The dashboard build, produced by `npm run build:web` at the repo root
# (frontend/ -> here). Generated, never edited, so it is not committed.
/public/app/
