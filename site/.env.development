# Development only. Next loads this for `next dev` and never for `next build`,
# which is precisely the switch next.config.ts keys off:
#
#   set   -> /app/* is proxied to the Vite dev server (HMR intact)
#   unset -> /app/* is served from public/app as static files
#
# So production needs no counterpart file, and no one has to remember to unset
# anything before building.
DASHBOARD_ORIGIN=http://localhost:5173
