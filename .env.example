# Tripwire testnet deployment config
# See DEPLOY_TESTNET.md for setup instructions

# Required: the deployer/owner private key (with testnet funds)
PRIVATE_KEY=0xabc123abc123abc123abc123abc123abc123abc123abc123abc123abc123abc1

# Required for Sepolia only (not needed for Apothem which uses built-in RPC)
SEPOLIA_URL=https://eth-sepolia.alchemyapi.io/v2/<YOUR ALCHEMY KEY>

# Optional: for contract verification on Etherscan
ETHERSCAN_API_KEY=ABC123ABC123ABC123ABC123ABC123ABC1
