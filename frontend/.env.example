# Which network to point the dashboard at: "apothem" or "sepolia"
VITE_CHAIN=apothem

# Filled in once #21 (testnet deployment) has real addresses. The dashboard
# renders a clear "not deployed yet" state when these are unset.
VITE_SAFE_ADDRESS=
VITE_GUARD_ADDRESS=
VITE_RISK_REGISTRY_ADDRESS=

# The drainer demo's target NFT and attacker contract (from
# scripts/localDeploy.ts or scripts/deployTestnet.ts output). Only needed
# for the "simulate attack" button - the read-only views above work without them.
VITE_NFT_ADDRESS=
VITE_ATTACKER_ADDRESS=

# Backend orchestrator URL (issue #102). Start the orchestrator with:
#   cd backend && npm run orchestrator
# The risk feed polls GET /tx, and the attack button POSTs to /tx/propose.
VITE_BACKEND_URL=http://localhost:3001

# Optional overrides (only needed if the orchestrator runs on non-default paths):
# VITE_RISK_FEED_URL=http://localhost:3001/tx
# VITE_ATTACK_TRIGGER_URL=http://localhost:3001/tx/propose

# Audit API (issue #52). Start it with:
#   cd backend && npm run audit
# It listens on AUDIT_PORT (default 3002), a different port to the orchestrator,
# so AuditCard needs the full URL rather than the shared backend origin.
VITE_AUDIT_URL=http://localhost:3002/audit

# Simulation API. Start it with:
#   cd backend && npm run sim
# Listens on SIM_PORT (default 3003).
VITE_SIM_URL=http://localhost:3003/simulations/latest

# Natural-language policy compiler. Served by the orchestrator, so this only
# needs setting if it runs somewhere other than VITE_BACKEND_URL.
# VITE_POLICY_URL=http://localhost:3001/policy/compile

# Where the "Tripwire" wordmark and the root breadcrumb point. Defaults to "/",
# which is correct whenever the site serves the dashboard under /app. Only set
# this when running `vite dev` on its own, or against a separate deployment:
# VITE_SITE_URL=http://localhost:3000
