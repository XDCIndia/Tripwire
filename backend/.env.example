SAFE_ADDRESS=0xYourSafeAddressHere
CHAIN_ID=11155111
# Optional: only needed for a self-hosted or non-default Transaction Service.
TX_SERVICE_URL=
# Required when using api.safe.global / api.5afe.dev - get one at developer.safe.global
SAFE_TX_SERVICE_API_KEY=
POLL_INTERVAL_MS=5000
# Optional: GoPlus Security API key. The free tier works without one, at lower rate limits.
GOPLUS_API_KEY=
# Optional: per-request timeout for GoPlus blacklist lookups, in ms.
GOPLUS_TIMEOUT_MS=3000
