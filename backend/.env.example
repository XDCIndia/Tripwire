SAFE_ADDRESS=0xYourSafeAddressHere
# 51 = XDC Apothem, matching frontend/src/chains.ts and VITE_CHAIN=apothem.
# Read by backend/src/index.ts (the watcher) to choose which chain to poll, so
# a mismatch here means the watcher polls a chain the Guard is not deployed on:
# no verdicts arrive, and the Guard fails closed on everything. Sepolia is
# 11155111 - change both this and VITE_CHAIN together, never one alone.
CHAIN_ID=51
# Optional: only needed for a self-hosted or non-default Transaction Service.
TX_SERVICE_URL=
# Required when using api.safe.global / api.5afe.dev - get one at developer.safe.global
SAFE_TX_SERVICE_API_KEY=
POLL_INTERVAL_MS=5000
# Optional: GoPlus Security API key. The free tier works without one, at lower rate limits.
GOPLUS_API_KEY=
# Optional: per-request timeout for GoPlus blacklist lookups, in ms.
GOPLUS_TIMEOUT_MS=3000

# Orchestrator HTTP server (issue #102)
# Start with: npm run orchestrator
# Serves GET /health, GET /tx (risk feed), POST /tx/propose
ORCHESTRATOR_PORT=3001
RPC_URL=http://127.0.0.1:8545
RISK_REGISTRY_ADDRESS=
RELAYER_PRIVATE_KEY=

# Audit API. Start with: npm run audit
# Serves GET /audit/health, GET /audit, GET /audit/timeline/:txHash
AUDIT_PORT=3002
# Where the audit trail is written. Both the orchestrator and the audit API
# use this same file, which is how the dashboard's audit card gets populated.
# Set to :memory: to disable persistence (the trail then resets on restart).
AUDIT_LOG_PATH=./.data/audit.jsonl

# Simulation API. Start with: npm run sim
# Serves GET /health, GET /simulations/latest
SIM_PORT=3003
SIM_STORE_CAPACITY=50

# All four services at once, from the repo root: npm run dev:all

# Anthropic API, used by llmReasoning.ts for the contextual-judgment pass.
# Optional: with no key the LLM step is skipped and the deterministic
# rule-engine verdict stands on its own - the pipeline never blocks on it.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to DEFAULT_MODEL in llmReasoning.ts.
ANTHROPIC_MODEL=
